{
  "name": "armenian-blot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "engine:build": "node scripts/build-engine.mjs",
    "dev": "pnpm engine:build && pnpm --filter @blot/web dev",
    "dev:web": "pnpm --filter @blot/web dev",
    "build": "pnpm engine:build && pnpm --filter @blot/web build",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "pnpm --filter @blot/web test",
    "test:e2e": "pnpm --filter @blot/web test:e2e",
    "typecheck": "pnpm --filter @blot/web typecheck",
    "dev:online": "pnpm engine:build && node scripts/dev-online.mjs"
  }
}
